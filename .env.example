# ===== Обязательные =====
# Пароль PostgreSQL и секрет сессий — обязательно замените.
POSTGRES_PASSWORD=change_me_strong_password
SESSION_SECRET=change_me_long_random_string

# ===== Основное =====
APP_URL=http://localhost
HTTP_PORT=80
POSTGRES_DB=text_app
POSTGRES_USER=app

SESSION_TTL_DAYS=7
MAGIC_LINK_TTL_MINUTES=15
DAILY_LIMIT=3
MAX_TEXT_LENGTH=10000

# ===== Нейросеть =====
# auto     — GigaChat, если задан GIGACHAT_AUTH_KEY; иначе OpenAI-совместимый; иначе локальный
# gigachat — только GigaChat
# openai   — только OpenAI-совместимый API
# local    — без сети
LLM_PROVIDER=auto

# ----- GigaChat (Сбер) -----
# Ключ авторизации из личного кабинета developers.sber.ru (Client ID:Client Secret в base64).
# Вставьте значение после знака "=". Файл .env в git не попадает.
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B (ИП/юрлица, предоплата) | GIGACHAT_API_CORP (постоплата)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_TIMEOUT_MS=60000
GIGACHAT_USER_AGENT=text-humanly/1.0
# Необязательно: свой путь к сертификату НУЦ Минцифры (по умолчанию server/certs/…)
GIGACHAT_CA_CERT_PATH=

# ----- Резервный OpenAI-совместимый API -----
# Если ключ не задан, приложение использует встроенный алгоритм упрощения.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# ===== Почта (magic-link) =====
# Если SMTP не настроен, ссылка для входа пишется в логи сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Текст по-человечески <no-reply@example.com>"

# ===== OCR =====
OCR_LANG=rus

# ===== Бот ВКонтакте (Bots Long Poll API) =====
# Ключ доступа сообщества: Управление → Дополнительно → Работа с API → Создать ключ.
# Права: messages, groups. Это секрет — файл .env в git не попадает.
VK_BOT_ENABLED=true
VK_ACCESS_TOKEN=
# Числовой ID сообщества (без минуса), например 123456789
VK_GROUP_ID=
# Кому присылать уведомления: peer_id пользователя (админа) или беседы.
# 0 — только сохранять историю, без отправки сообщений.
VK_NOTIFY_PEER_ID=0
# VK ID администраторов через запятую (кому разрешены /stats, /today). Пусто — всем.
VK_ADMIN_IDS=
