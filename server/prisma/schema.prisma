generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  createdAt      DateTime         @default(now())
  sessions       Session[]
  requests       Request[]
  tokens         LoginToken[]
  vkNotifications VkNotification[]
  requestTokens  RequestToken[]
}

model LoginToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Request {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputText  String
  level      String
  resultText String?
  status     String
  createdAt  DateTime  @default(now())
  requestDay String

  @@index([userId, requestDay])
}

model VkNotification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vkUserId    Int
  totalTokens Int      @default(0)
  sentAt      DateTime @default(now())

  @@index([userId])
  @@index([sentAt])
}

model RequestToken {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId    String
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([requestId])
}
