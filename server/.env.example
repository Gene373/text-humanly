# App
APP_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# База данных
DATABASE_URL=postgresql://app:app@localhost:5433/text_app

# Сессии
SESSION_SECRET=dev_secret_change_me_in_production
SESSION_TTL_DAYS=7
MAGIC_LINK_TTL_MINUTES=15

# ===== Нейросеть =====
# auto     — GigaChat, если задан GIGACHAT_AUTH_KEY, иначе OpenAI-совместимый, иначе локальный
# gigachat — только GigaChat
# openai   — только OpenAI-совместимый API
# local    — без сети, встроенный rule-based упроститель
LLM_PROVIDER=auto

# ----- GigaChat (Сбер) -----
# Ключ авторизации из личного кабинета developers.sber.ru (Client ID:Client Secret в base64).
# Вставьте значение ПОСЛЕ знака "=" в файле server/.env. Файл .env в git не попадает.
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B (ИП/юрлица, предоплата) | GIGACHAT_API_CORP (ИП/юрлица, постоплата)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Целевой адрес API с 17.07.2026. Старый: https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_TIMEOUT_MS=60000
GIGACHAT_USER_AGENT=text-humanly/1.0
# Если ОС не доверяет цепочке api.giga.chat — путь к russian_trusted_root_ca_pem.crt
# (скачивается с https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt)
GIGACHAT_CA_CERT_PATH=

# ----- Любой OpenAI-совместимый API (резервный вариант) -----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# Почта (если не задана — ссылка пишется в консоль и лог)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Текст по-человечески <no-reply@example.com>"

# OCR (Tesseract по умолчанию, локально)
OCR_LANG=rus

# ===== Бот ВКонтакте =====
# Включить бота (true/false). По умолчанию включён.
VK_BOT_ENABLED=true
# Ключ доступа сообщества. Получается в: Управление → Дополнительно → Работа с API → Создать ключ.
# Права: messages, groups.
VK_ACCESS_TOKEN=
# Числовой ID сообщества (без минуса). Например: 12345678
VK_GROUP_ID=
# Кому слать уведомления (опционально). 0 = в диалог с сообществом.
# Для личного чата администратора: peer_id = 20000000000000000 + user_id
VK_NOTIFY_PEER_ID=0
# VK ID администраторов через запятую (кто может запрашивать /stats). Пусто = все.
VK_ADMIN_IDS=

# Лимиты
DAILY_LIMIT=3
MAX_TEXT_LENGTH=10000
